# ==============================================================================
# Mini D-Mart - Environment Variables Template (.env.example)
# Copy this file to .env (or configure in your production environment)
# DO NOT commit real secrets or credentials into version control.
# ==============================================================================

# Backend Server Configuration
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/dmart_db
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# JWT (JSON Web Token) Security Settings
JWT_SECRET=your_base64_encoded_256bit_jwt_secret_here
JWT_EXPIRATION=86400000

# CORS Configuration (Comma-separated origins for production)
CORS_ORIGIN=http://localhost:5173

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api